SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Options: sqlite, postgresql, mysql
DB_ENGINE=sqlite

# PostgreSQL Configuration (if DB_ENGINE=postgresql)
# DB_NAME=gestionnaire_rh_guinee
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require   # bases hébergées (Render, Neon, DigitalOcean…) ; prefer par défaut

# MySQL Configuration (if DB_ENGINE=mysql)
# DB_NAME=guineerh_db
# DB_USER=your_mysql_user
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=3306

# SQLite (default - no additional config needed)

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Application Settings
COMPANY_NAME=Votre Entreprise
COMPANY_NIF=000000000
COMPANY_CNSS=000000000

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS Settings (Set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# IP Whitelist (Optional - comma separated IPs)
IP_WHITELIST_ENABLED=False
IP_WHITELIST=

# Admin Email for Security Alerts
ADMIN_EMAIL=admin@example.com

# ============================================================================
# CINETPAY PAYMENT GATEWAY
# ============================================================================
# Créez un compte sur https://cinetpay.com et obtenez vos clés
CINETPAY_API_KEY=your-api-key
CINETPAY_SITE_ID=your-site-id
CINETPAY_SECRET_KEY=your-secret-key
CINETPAY_MODE=test  # 'test' ou 'live'

# Site URL pour les callbacks
SITE_URL=https://www.guineerh.space
